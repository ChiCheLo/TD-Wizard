/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data (only ignore when the asset itself is ignored)
!/[Aa]ssets/**/*.meta

